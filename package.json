    "@vitejs/plugin-react": "^4.5.2",
    "babel-plugin-react-compiler": "^1.0.0",
    "lefthook": "^2.1.0",
    "nx": "^22.5.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "typescript": "^5.8.3",
    "vite": "^7.3.1"
  },
  "engines": {
    "bun": ">=1.0.0"
